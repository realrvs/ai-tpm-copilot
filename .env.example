# ─── GitHub ─────────────────────────────────────────────────────
# Personal Access Token with repo scope
GITHUB_TOKEN=ghp_your_personal_access_token_here

# ─── YandexGPT / Yandex Cloud ──────────────────────────────────
# Service account JWT or IAM token
YC_IAM_TOKEN=your_iam_token_here
# Alternative: service account JSON key path (if using SA key)
# YC_SA_KEY_PATH=./service-account.json
# Folder ID for YandexGPT
YC_FOLDER_ID=your_folder_id_here

# ─── Telegram ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ─── Database (optional, default SQLite) ────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/tpm_copilot.db

# ─── OpenTelemetry ──────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-tpm-copilot

# ─── Feature Flags ──────────────────────────────────────────────
ENABLE_TELEGRAM_DELIVERY=false
ENABLE_FACT_CHECK_STRICT=true
ENABLE_LLM_PROVIDER_YANDEXGPT=true
ENABLE_FUZZY_MATCHING=true
ENABLE_PII_REDACTION_PRESIDIO=true
